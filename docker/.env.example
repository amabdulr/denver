# =============================================================
# Denver App – Environment Variables
# Copy this file to ../.env and fill in the values
# =============================================================

# --- API provider: "cxai" or "bridgeit" ---
CISCO_API_TYPE=cxai

# --- CX-AI (OpenAI-compatible) settings ---
OPENAI_API_BASE=
OPENAI_API_KEY=

# --- BridgeIt settings (only needed when CISCO_API_TYPE=bridgeit) ---
BRIDGEIT_CLIENT_ID=
BRIDGEIT_CLIENT_SECRET=
BRIDGEIT_APP_KEY=
BRIDGEIT_BRAIN_USER_ID=
