# =============================================================
# Denver App – Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# Set which API to use: 'cxai' or 'bridgeit'
CISCO_API_TYPE=bridgeit

# CX AI Playground authentication (required if CISCO_API_TYPE=cxai)
OPENAI_API_BASE="https://cxai-playground.cisco.com/"
OPENAI_API_KEY=your-key-here

# BridgeIt authentication (required if CISCO_API_TYPE=bridgeit)
BRIDGEIT_CLIENT_ID=your-client-id
BRIDGEIT_CLIENT_SECRET=your-client-secret
BRIDGEIT_APP_KEY=your-app-key
BRIDGEIT_BRAIN_USER_ID=your-cisco-userid

# LangSmith tracing configuration (optional)
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT="https://ai-insights.cisco.com/api/v1"
LANGSMITH_API_KEY="your-langsmith-key"
LANGSMITH_PROJECT="your-project-name"
