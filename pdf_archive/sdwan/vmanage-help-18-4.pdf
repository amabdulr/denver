                <script type="text\html" id="jstemplatedata">
                      <li>
                      <% if (section == "video"){ %>
                          <a href="${url}">${icon_type}</a>
                      <% } else { %>
                          ${icon_type}
                      <% } %>
                          <div>
                            <a href="${url}" class="title">${title}</a>
                                <% if(teaser && teaser != ""){%>
                            <div class="description">${teaser} <div class="community_shortened">Board: <a href="${cscboardhref}">${cscboardtitle}</a></div></div>
                            <% } %>
                            <span class="community">Board: <a href="${cscboardhref}">${cscboardtitle}</a></span><span class="author">Created by: ${cscauthor}</span>
                            <span class="post-date">Posted: ${created_in}</span>
                            <%
                                if (section == "disc" && issolved) { 
                            %>
                            <span class="modified-date">Last Replied ${modified_in}</span>
                            <%
                                } else if (section != "video"){
                            %>
                              <span class="modified-date">Last modified: ${modified_in}</span>
                            <%}%>
                          </div>
                      </li>
                </script>
            

        </dd>


</dl>
